[Unit]
Description=Crescendo AI Music System
After=network.target sound.target

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=90
TimeoutStartSec=60
User=simoncockx
WorkingDirectory=/home/simoncockx/crescendo-ai
ExecStart=/home/simoncockx/crescendo-ai/venv/bin/python /home/simoncockx/crescendo-ai/crescendo.py --log-level INFO

# Always restart, no matter how often it fails or how quickly - for an
# unattended multi-day deployment, "keep trying" beats "give up after 5
# crashes in 10 seconds" (systemd's default StartLimitBurst).
Restart=always
RestartSec=5
StartLimitIntervalSec=0

Environment=PYTHONUNBUFFERED=1
# Needed for audio output (PulseAudio/ALSA look for the user session's
# runtime dir here) - without it, pygame's mixer can fail to find an
# audio sink under this system-level service. Adjust the UID (1000) if
# the service User= above has a different one.
Environment=XDG_RUNTIME_DIR=/run/user/1000

[Install]
WantedBy=multi-user.target
